{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "uiManagement": {
      "type": "string",
      "enum": ["readonly", "enabled"]
    },
    "hubAllowedRoles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "extraArgs": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
